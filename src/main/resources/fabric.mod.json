{
  "schemaVersion": 1,
  "id": "koboshmapartaddon",
  "version": "${version}",
  "name": "KoboshMapArtAddon",
  "description": "addon for wurst client",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/koboshmapartaddon/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.kobosh.koboshmapartaddon.client.WurstAddonDataGenerator"
    ],
    "client": [
      "com.kobosh.koboshmapartaddon.client.WurstAddonClient"
    ],
    "main": [
      "com.kobosh.koboshmapartaddon.WurstAddon"
    ]
  },
  "mixins": [
    "koboshmapartaddon.mixins.json",
    {
      "config": "koboshmapartaddon.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "wurst": "*"
  },
  "custom": {
    "modmenu": {
      "parent": "wurst",
      "links": {
        "modmenu.twitter": "https://x.com/kobosh_com/"
      }
    }
  }
}
